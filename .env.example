# Server only. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TEXT_MODEL=openai/gpt-oss-120b
# Optional emergency kill switch: set to 1 to disable all external AI requests.
DISABLE_AI=0
# Public pilot stays closed until explicitly enabled AND this date has passed.
PILOT_AI_ENABLED=0
PILOT_NOT_BEFORE=2026-11-22T00:00:00Z
# Shared Redis counters contain no images, labels or health histories.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
RATE_LIMIT_SECRET=
REQUIRE_DURABLE_LIMITS=0
AI_CLIENT_MINUTE_LIMIT=6
AI_GLOBAL_MINUTE_LIMIT=30
AI_DAILY_REQUEST_LIMIT=100
AI_MONTHLY_REQUEST_LIMIT=1000
REVIEWED_CONTENT_SHA256=
# Optional strict supervised-pilot policy. Public educational AI is enabled by default.
ENFORCE_PILOT_GATES=0
