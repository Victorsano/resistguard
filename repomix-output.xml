'use client';
import {useState} from 'react';
import {ArrowRight,Download,Check} from 'lucide-react';
import {scenarios,sources,medicines} from '@/lib/safety';
import fixtures from '@/data/scan-fixtures.json';
const quiz=[{q:'Does a package match mean the medicine is safe for you?',choices:['Yes','No'],answer:1,why:'A label match does not verify authenticity or personal suitability. Ask a pharmacist or prescriber.'},{q:'What becomes resistant to an antibiotic?',choices:['Your body','The bacteria'],answer:1,why:'Bacteria can become resistant. Unnecessary antibiotic exposure can encourage resistant bacteria to survive and spread.'},{q:'A photo shows two active ingredients. What should the app do?',choices:['Match just the first ingredient','Check the complete combination'],answer:1,why:'Every active ingredient must match the complete record. A combination must never silently become a single-ingredient match.'}];
export default function Learning({onSample}:{onSample:(filename:string)=>void}){
 const [answers,setAnswers]=useState<Record<number,number>>({});
 return <section className="content-view"><span className="eyebrow">THE KNOWLEDGE CORNER</span><h1>Keep antibiotics<br/><em>working for everyone.</em></h1><p>Antimicrobial resistance happens when germs change and medicines become less effective. It is the germs, not your body, that become resistant.</p><div className="learning-grid">{Object.entries(scenarios).filter(([id])=>['cold','sharing','leftovers','prescribed'].includes(id)).map(([id,s],i)=><article key={id}><span className="number">0{i+1}</span><h2>{s.title}</h2><p>{s.text}</p></article>)}</div>
