<file path="app/api/scan/route.ts">
import {groq,GroqError} from '@/lib/groq';
import {allow,readBody,sameOrigin} from '@/lib/guard';
import {authorizeAI,gateMessage,operationalEvent} from '@/lib/availability';
import {parseObservation,classifyObservation,scanPrompt,unavailableScan} from '@/lib/scan';
export const runtime='nodejs';
export const maxDuration=30;
export async function POST(request:Request) {
 const fallback=(message:string,status=200)=>Response.json(unavailableScan(message),{status,headers:{'Cache-Control':'no-store',...(status===429?{'Retry-After':'60'}:{})}});
 if(!sameOrigin(request))return fallback('Request origin rejected.',403);
 if(!allow(request.headers.get('x-forwarded-for')?.split(',')[0]??'local'))return fallback('Request limit reached. Use the manual catalogue.',429);
 let body;try{body=await readBody(request);}catch{return fallback('Use a JPEG or PNG under 2 MB.',400);}
 const image=body?.image;
 if(typeof image!=='string'||!/^data:image\/(jpeg|png);base64,[A-Za-z0-9+/]+={0,2}$/.test(image)||image.length>2_800_000)return fallback('Use a JPEG or PNG under 2 MB.',400);
 const bytes=Buffer.from(image.split(',')[1],'base64');
 const valid=image.startsWith('data:image/png')?bytes.subarray(0,8).equals(Buffer.from([137,80,78,71,13,10,26,10])):bytes[0]===255&&bytes[1]===216&&bytes[2]===255;
 if(!valid)return fallback('The file does not match its image type.',400);
 const gate=await authorizeAI(request);
 if(!gate.ok){operationalEvent('scan','fallback',gate.reason);return Response.json({...unavailableScan(gateMessage(gate.reason)),reason:gate.reason},{status:gate.reason==='request_limit'?429:200,headers:{'Cache-Control':'no-store',...(gate.reason==='request_limit'?{'Retry-After':'60'}:{})}});}
 try{
 const raw=await groq(process.env.GROQ_VISION_MODEL||'qwen/qwen3.8-27b',[
 {role:'system',content:scanPrompt},
 {role:'user',content:[{type:'text',text:'Observe the product and transcribe its complete active-ingredient label. Report uncertainty honestly.'},{type:'image_url',image_url:{url:image}}]}],true);
 const result=classifyObservation(parseObservation(raw));operationalEvent('scan','success','ready');
 return Response.json(result,{headers:{'Cache-Control':'no-store'}});
 }catch(e){
 const reason=e instanceof GroqError?e.reason:'invalid_response';
 operationalEvent('scan','fallback',reason==='spending_limit'?'provider_spending_limit':reason==='rate_limit'?'provider_rate_limit':reason==='timeout'?'provider_timeout':reason==='invalid_response'?'invalid_response':'provider_connection');
 const messages:Record<string,string>={spending_limit:'The provider spending limit has stopped AI access. Use the source-linked catalogue.',not_configured:'AI is not enabled on this server. Use the manual catalogue.',rate_limit:'The AI provider request limit was reached. Try again later or use the manual catalogue.',authentication:'The AI provider could not authenticate this server. Use the manual catalogue while the connection is checked.',model_unavailable:'The configured vision model is unavailable. Use the manual catalogue.',timeout:'The AI provider took too long to respond. Try again or use the manual catalogue.',connection:'The AI provider could not be reached. Try again or use the manual catalogue.',invalid_response:'The AI response was incomplete or could not be validated. No medicine has been selected. Try another photo or use the manual catalogue.'};
 return Response.json({...unavailableScan(messages[reason]),reason},{headers:{'Cache-Control':'no-store'}});
 }
}
</file>

<file path="app/api/use-evidence/route.ts">
import {groq} from '@/lib/groq';
import {allow,readBody,sameOrigin} from '@/lib/guard';
import {authorizeAI,operationalEvent} from '@/lib/availability';
import {parseEvidenceRequest,retrieveUseEvidence,validateEvidenceOrder,useTopics} from '@/lib/use-check';

export const runtime='nodejs';
export const maxDuration=30;

export async function POST(request:Request) {
  const headers={'Cache-Control':'no-store'};
  if(!sameOrigin(request)) return Response.json({error:'Origin rejected'},{status:403,headers});
  let body:unknown;
  try {body=await readBody(request);} catch {return Response.json({error:'Invalid request'},{status:400,headers});}
  const topic=parseEvidenceRequest(body);
  if(!topic) return Response.json({error:'Choose a listed education topic.'},{status:400,headers});
  const passages=retrieveUseEvidence(topic);
  const ids=passages.map(p=>p.id);
  const fallback=(notice:string)=>Response.json({mode:'source-based',passageIds:ids,notice},{headers});
  if(ids.length===1) return fallback('The source passage is available directly.');
  if(!allow(request.headers.get('x-forwarded-for')?.split(',')[0]??'local')) return fallback('Request limit reached.');
  const gate=await authorizeAI(request);
  if(!gate.ok) return fallback('AI is temporarily unavailable. All source passages remain available.');
  try {
    const raw=await groq(process.env.GROQ_TEXT_MODEL||'openai/gpt-oss-120b',[
      {role:'system',content:'Order the supplied public education passage IDs by relevance to the fictional learning topic. Return JSON with exactly {"passageIds":[all supplied unique IDs]}. Include every ID. Never write medical advice or new text.'},
      {role:'user',content:JSON.stringify({topic:useTopics[topic].example,passages:passages.map(({id,title,text})=>({id,title,text}))})}
    ],true);
    const passageIds=validateEvidenceOrder(raw,ids);
    operationalEvent('explain','success','ready');
    return Response.json({mode:'AI-organised source-based education',passageIds},{headers});
  } catch {
    operationalEvent('explain','fallback','provider_failure');
    return fallback('AI unavailable. All source passages remain visible.');
  }
}
</file>

<file path="app/components/AskResistGuard.tsx">
'use client';

import {useEffect,useRef,useState} from 'react';
import {MessageCircle,X} from 'lucide-react';
import {assess,questions,scenarios,type Scenario} from '@/lib/safety';
import {getPassage} from '@/lib/use-check';
import './ask-resistguard.css';

export type AssistantContext={medicineId?:string;scenario?:Scenario;unclear?:boolean};
export type AssistantSession={context:AssistantContext;explain?:boolean};
type Answer={question:string;text:string;paragraphs?:string[];questions?:string[];sources?:{name:string;url:string}[];notice?:string};

const generalAnswers={
  scan:{question:'How do I photograph the label?',text:'Turn the pack so the ingredient line is horizontal. Use even light and keep the entire ingredient line in frame. If glare hides a word, tilt the pack and try again.'},
  registry:{question:'What does a NAFDAC number tell me?',text:'It points to a product record in the Greenbook. In Catalogue, search the number and compare the complete ingredient list with the pack.',sources:[{name:'NAFDAC Greenbook',url:'https://greenbook.nafdac.gov.ng/'}]},
  amr:{question:'Why does responsible antibiotic use matter?',text:getPassage('amr').text,sources:[getPassage('amr').reference]}
} satisfies Record<string,Answer>;

export default function AskResistGuard({session,onClose,onCatalogue}:{session:AssistantSession;onClose:()=>void;onCatalogue:()=>void}){
  const dialog=useRef<HTMLDialogElement>(null);
  const lastTurn=useRef<HTMLDivElement>(null);
  const controller=useRef<AbortController|null>(null);
  const [turns,setTurns]=useState<Answer[]>([]);
  const [busy,setBusy]=useState(false);
  const context=session.context;
  const selected=context.medicineId?assess(context.medicineId,context.scenario??'general'):null;
  useEffect(()=>{lastTurn.current?.scrollIntoView({block:'nearest'});},[turns.length]);

  useEffect(()=>{
    const el=dialog.current;
    el?.showModal();
    return ()=>{controller.current?.abort();el?.close();};
  },[]);

  function add(answer:Answer){
    controller.current?.abort();
    controller.current=null;
    setBusy(false);
    setTurns(previous=>[...previous,answer]);
  }

  async function explain(scenario:Scenario){
    const result=assess(context.medicineId,scenario);
    if(!result)return;
    controller.current?.abort();
    const request=new AbortController();
    controller.current=request;
    const timeout=setTimeout(()=>request.abort(),23000);
    const fallback:Answer={
      question:scenario==='cold'?'Why doesn’t this antibiotic treat flu?':`Explain ${scenarios[scenario].label.toLowerCase()} simply`,
      text:result.rule.text,paragraphs:[result.medicine.summary,result.medicine.caution],
      questions:[questions.need,questions.interactions],
      sources:[{name:result.medicine.sourceLabel,url:result.medicine.source},...result.sources]
    };
    setBusy(true);
    try {
      const response=await fetch('/api/explain',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({id:context.medicineId,scenario}),signal:request.signal});
      if(!response.ok)throw new Error('Explanation unavailable');
      const data=await response.json();
      if(controller.current===request)setTurns(previous=>[...previous,{...fallback,...data,question:fallback.question}]);
    } catch {
      if(controller.current===request)setTurns(previous=>[...previous,{...fallback,notice:'Showing source guidance while the connection is unavailable.'}]);
    } finally {
      clearTimeout(timeout);
      if(controller.current===request)setBusy(false);
    }
  }

  useEffect(()=>{
    if(session.explain&&context.medicineId)void explain(context.scenario??'general');
    return ()=>{controller.current?.abort();controller.current=null;};
  },[]);

  return <dialog className="ask-panel" ref={dialog} aria-labelledby="ask-title" onCancel={event=>{event.preventDefault();onClose();}}>
    <header className="ask-header">
      <div><h2 id="ask-title"><MessageCircle size={22} aria-hidden="true"/> Ask ResistGuard</h2><p>Medicine labels and antibiotic education</p></div>
      <button autoFocus className="ask-close" aria-label="Close assistant" onClick={onClose}><X size={22}/></button>
    </header>
    <div className="ask-body">
      {selected&&<p className="ask-context">Confirmed ingredient entry · {selected.medicine.name}</p>}
      {context.unclear&&<p className="ask-context">Scan needs a clearer ingredient label</p>}
      <div className="ask-prompts" aria-label="Suggested questions">
        {selected&&<button className="secondary" disabled={busy} onClick={()=>void explain(context.scenario??'general')}>Explain my selected topic</button>}
        {selected?.medicine.antibiotic&&context.scenario!=='cold'&&<button className="secondary" disabled={busy} onClick={()=>void explain('cold')}>Why doesn’t this antibiotic treat flu?</button>}
        {Object.values(generalAnswers).map(answer=><button key={answer.question} className="secondary" disabled={busy} onClick={()=>add(answer)}>{answer.question}</button>)}
      </div>
      <div className="ask-conversation" aria-live="polite">
        {turns.map((turn,index)=><div className="ask-turn" key={index} ref={index===turns.length-1?lastTurn:undefined}>
          <p className="ask-question">{turn.question}</p>
          <div className="ask-answer">
            <p>{turn.text}</p>
            {turn.paragraphs?.length?<ul>{turn.paragraphs.map(text=><li key={text}>{text}</li>)}</ul>:null}
            {turn.questions?.length?<><h3>Ask a pharmacist</h3><ul>{turn.questions.map(text=><li key={text}>{text}</li>)}</ul></>:null}
            {turn.notice&&<p className="field-help">{turn.notice}</p>}
            {turn.sources?.map(source=><a key={source.url} href={source.url} target="_blank" rel="noreferrer">{source.name} ↗</a>)}
            {turn.question===generalAnswers.registry.question&&<button className="text-button" onClick={onCatalogue}>Open Catalogue</button>}
          </div>
        </div>)}
        {busy&&<p role="status">Preparing the explanation…</p>}
      </div>
    </div>
    <p className="ask-footer">For diagnosis, treatment or personal suitability, speak to a pharmacist or clinician.</p>
  </dialog>;
}
</file>

