<file path="app/components/Catalogue.tsx">
'use client';

import {useState} from 'react';
import {Search,ArrowUpRight,ArrowRight} from 'lucide-react';
import {medicines,nigeriaCatalogueDetails,nigeriaSources} from '@/lib/safety';
import './catalogue-references.css';

export default function Catalogue({onChoose}:{onChoose:(id:string)=>void}){
  const [query,setQuery]=useState('');
  const [filter,setFilter]=useState('all');
  const term=query.trim().toLowerCase();
  const results=medicines.map(m=>({m,...nigeriaCatalogueDetails(m.id)})).filter(({m,forms,products})=>{
    if(filter==='antibiotics'&&!m.antibiotic || filter==='other'&&m.antibiotic) return false;
    if(filter==='nigeria'&&!forms.some(form=>['adult','child','euroclox'].includes(form.source))&&!products.length) return false;
    if((filter==='adult'||filter==='child')&&!forms.some(form=>form.source===filter)) return false;
    return [m.name,m.category,...m.ingredients,...products.flatMap(product=>[product.name,product.number])]
      .join(' ').toLowerCase().includes(term);
  });
  return <section className="content-view">
    <h1>Medicine catalogue</h1>
    <p>Look up {medicines.length} generic medicine records and selected Nigerian product references. Compare all active ingredients with the package before confirming a match.</p>
    <div className="catalogue-toolbar">
      <label className="search-field"><Search size={19}/><input type="search" placeholder="Ingredient, brand or NAFDAC number" aria-label="Search catalogue" value={query} onChange={event=>setQuery(event.target.value)}/></label>
      <select value={filter} onChange={event=>setFilter(event.target.value)} aria-label="Filter catalogue">
        <option value="all">All medicines</option><option value="antibiotics">Antibiotics</option><option value="other">Non-antibiotics</option>
        <option value="nigeria">Nigerian sources</option><option value="adult">Nigeria adult list</option><option value="child">Nigeria children’s list</option>
      </select>
    </div>
    <p role="status" className="field-help">{results.length} records shown</p>
    <div className="medicine-grid">{results.map(({m,forms,products})=><article key={m.id}>
      <span className={`pill ${m.antibiotic?'':'non-antibiotic-pill'}`}>{m.antibiotic?'Antibiotic':'Non-antibiotic'}</span>
      <h2>{m.name}</h2>
      <p className="review-label">Pharmacist review pending · Check due {m.reviewDue}</p>
      <p className="ingredient-list">{m.ingredients.join(' + ')}</p>
      <p>{m.summary}</p>
      <p className="catalogue-caution">{m.caution}</p>
      {(forms.length>0||products.length>0)&&<details className="catalogue-references">
        <summary>Formulations and product references</summary>
        <p>Strengths describe the product label. A pharmacist can check which formulation and instructions apply.</p>
        {forms.map(form=><div key={form.source+form.form}>
          <strong>{form.form} · {form.strengths.join(', ')}</strong>
          <a href={form.reference.url} target="_blank" rel="noreferrer">{form.reference.name} · {form.section} ↗</a>
        </div>)}
        {products.map(product=><div key={product.name}>
          <strong>{product.name} · {product.form} · {product.strength}</strong>
          <a href={product.url} target="_blank" rel="noreferrer">NAFDAC Greenbook · {product.number} ↗</a>
          <small>Register status on {product.checked} · {product.registerStatus}</small>
        </div>)}
        {products.length>0&&<p>Greenbook references describe listed products. Check current registration directly in the register and confirm the ingredients on your package.</p>}
      </details>}
      <div className="catalogue-card-footer">
        <button className="secondary" onClick={()=>onChoose(m.id)}>Check this label <ArrowRight size={15}/></button>
        <a href={m.source} target="_blank" rel="noreferrer">{m.sourceLabel}{'sourceSection' in m?` · ${m.sourceSection}`:''} <ArrowUpRight size={14}/></a>
      </div>
    </article>)}</div>
    {!results.length&&<p className="small-note">No entries match this search. Try the generic ingredient printed on the package or ask a pharmacist.</p>}
    <details className="catalogue-references catalogue-source-register">
      <summary>Sources for the Nigerian expansion</summary>
      {Object.values(nigeriaSources).map(source=><div key={source.url}><a href={source.url} target="_blank" rel="noreferrer">{source.name} ↗</a><p>{source.version} · {source.scope}</p></div>)}
    </details>
  </section>;
}
</file>

<file path="app/components/Pilot.tsx">
'use client';
import {useState} from 'react';
import {Download,ClipboardCheck,ShieldCheck,Trash2} from 'lucide-react';
import {medicines} from '@/lib/safety';
import {platforms,browsers,conditions,pilotOutcome,pilotSummary,validatePilotRow,type PilotRow} from '@/lib/pilot';
function download(value:unknown,name:string){const url=URL.createObjectURL(new Blob([JSON.stringify(value,null,2)],{type:'application/json'}));const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}
export default function Pilot(){
 const [consent,setConsent]=useState(false);const [exportConsent,setExportConsent]=useState(false);const [groundTruth,setGroundTruth]=useState(false);const [rows,setRows]=useState<PilotRow[]>([]);const [message,setMessage]=useState('');
 const [row,setRow]=useState<PilotRow>({platform:'android',browser:'chrome',condition:'clear',expected:'amoxicillin',observed:'none',result:'uncertain',understoodBoundary:false,knowsNextStep:false});
 const summary=pilotSummary(rows);
 function add(){if(!consent||!groundTruth||!validatePilotRow(row,medicines.map(m=>m.id))){setMessage('Confirm consent and the expected label, then check the outcome fields.');return;}setRows(r=>[...r,{...row}]);setGroundTruth(false);setRow(r=>({...r,decision:'not_observed',understoodBoundary:false,knowsNextStep:false}));setMessage('Observation added on this device only. Export before closing this page.');}
 return <section className="content-view pilot-view"><span className="eyebrow">PREPARE, REVIEW, THEN INVITE</span><h1>A careful pilot.<br/><em>Evidence before claims.</em></h1><p>Prepare for the planned week of 22 November 2026. No volunteers have been recruited and no pharmacist has signed off. These tools help a facilitator record real observations later.</p>
 <div className="pilot-status"><span className="pill">Pilot not started</span><span className="pill">Pharmacist review pending</span><span className="pill">No automatic launch</span></div>
 <div className="learning-grid"><article><ClipboardCheck size={26}/><h2>Pharmacist review</h2><p>Download the versioned packet: catalogue, ingredient aliases, safety rules, explanations and sign-off checklist. Review every record and every safety message against its source.</p><a className="secondary" href="/review-packet.json" download><Download size={16}/>Download review packet</a><p className="field-help">A content fingerprint ties the review to this exact version. A changed version needs another review. Downloading is not approval.</p></article><article><ShieldCheck size={26}/><h2>Real-phone test plan</h2><p>Use Android Chrome and iPhone Safari where available. Check sharp labels, reflections, blur, small print, cropped combinations, denied camera permission and interrupted connections.</p><ol className="pilot-plan"><li>Ask an adult volunteer for informed consent.</li><li>Have a facilitator establish the full ingredient list from the original label.</li><li>Observe scanning without suggesting the expected result.</li><li>Record wrong matches and uncertainty, then ask what the result means.</li></ol><a className="secondary" href="/pilot-protocol.md" download><Download size={16}/>Download pilot protocol</a></article></div>
 <section className="quiz"><span className="eyebrow">OPTIONAL FACILITATOR TOOL · LOCAL MEMORY ONLY</span><h2>Record a pilot observation</h2><p>No names, health details, label text or images are collected here. Nothing in this form is sent to our server. Refreshing or leaving this view clears the records; export only with the participant’s agreement.</p>
 <label className="consent"><input type="checkbox" checked={consent} onChange={e=>setConsent(e.target.checked)}/>The adult participant agrees to this anonymous observation. This test will not guide a medical decision.</label>
 <div className="pilot-form">{[['Device',platforms,'platform'],['Browser',browsers,'browser'],['Photo / permission condition',conditions,'condition']] .map(([label,values,key])=><label className="field-label" key={String(key)}>{String(label)}<select aria-label={String(label)} value={String(row[key as keyof PilotRow])} onChange={e=>setRow(r=>({...r,[String(key)]:e.target.value}))}>{(values as readonly string[]).map(v=><option key={v}>{v}</option>)}</select></label>)}
 <label className="field-label">Expected record, established from the original label<select aria-label="Expected record" value={row.expected} onChange={e=>setRow(r=>({...r,expected:e.target.value}))}>{medicines.map(m=><option key={m.id} value={m.id}>{m.name}</option>)}<option value="unsupported">Outside catalogue</option><option value="non_medicine">Non-medicine</option><option value="unreadable">Insufficient evidence</option></select></label>
 <label className="field-label">What the app did<select aria-label="What the app did" value={row.result} onChange={e=>setRow(r=>({...r,result:e.target.value as PilotRow['result'],observed:'none',decision:'not_observed'}))}><option value="uncertain">No ingredient candidate / uncertain</option><option value="candidate">Suggested a candidate</option><option value="unavailable">Provider / connection unavailable</option></select></label>
 <label className="field-label">Candidate shown by the app<select aria-label="Candidate shown by the app" disabled={row.result!=='candidate'} value={row.observed} onChange={e=>setRow(r=>({...r,observed:e.target.value}))}><option value="none">None</option>{medicines.map(m=><option key={m.id} value={m.id}>{m.name}</option>)}</select></label>
 {row.result==='candidate'&&<label className="field-label">What did the participant do with the suggestion?<select value={row.decision??'not_observed'} onChange={e=>setRow(r=>({...r,decision:e.target.value as PilotRow['decision']}))}><option value="not_observed">Decision not observed</option><option value="accepted">Confirmed the suggested match</option><option value="did_not_confirm">Left the match unconfirmed</option></select></label>}</div>
 <label className="consent"><input type="checkbox" checked={groundTruth} onChange={e=>setGroundTruth(e.target.checked)}/>A facilitator checked every active ingredient on the original package; the expected record is not guessed from a brand.</label>
 <label className="consent"><input type="checkbox" checked={row.understoodBoundary} onChange={e=>setRow(r=>({...r,understoodBoundary:e.target.checked}))}/>The participant explains that recognition does not mean the medicine is safe or suitable.</label>
 <label className="consent"><input type="checkbox" checked={row.knowsNextStep} onChange={e=>setRow(r=>({...r,knowsNextStep:e.target.checked}))}/>The participant can describe a useful next step or question for a pharmacist.</label>
 <label className="consent"><input type="checkbox" checked={exportConsent} onChange={e=>setExportConsent(e.target.checked)}/>The participant separately agrees to exporting this anonymous observation for the pilot review.</label><div className="button-row"><button className="primary" disabled={!consent||!groundTruth||rows.length>=100} onClick={add}>Add observation</button><button className="secondary" disabled={!rows.length||!consent||!exportConsent} onClick={()=>download({schema:'resistguard-pilot-v1',date:new Date().toISOString().slice(0,10),evidence:'facilitator_reported_not_independently_verified',summary,observations:rows.map(r=>({...r,outcome:pilotOutcome(r)}))},'resistguard-pilot.json')}><Download size={16}/>Export anonymous report</button><button className="text-button" onClick={()=>{setRows([]);setMessage('Local observations cleared.');}}><Trash2 size={15}/>Clear observations</button></div>{message&&<p role="status">{message}</p>}
 <div className="pilot-results" aria-live="polite"><strong>{summary.total} observations</strong><span>{summary.correct} correct candidates</span><span>{summary.incorrect} incorrect candidates</span><span>{summary.wrongWithDecision ? `${summary.wrongAccepted} of ${summary.wrongWithDecision} incorrect suggestions with an observed decision were accepted` : 'No observed decisions on incorrect suggestions'}</span><span>{summary.uncertain} uncertain</span><span>{summary.unavailable} unavailable</span></div><p className="field-help">These are locally entered observations, not verified trial results or the synthetic dashboard. An incorrect candidate is a stop-and-investigate finding, not something to hide in an average.</p></section></section>;
}
</file>

