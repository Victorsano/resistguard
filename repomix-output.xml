<file path="scripts/review-packet.mjs">
import fs from 'node:fs/promises';
import {createHash} from 'node:crypto';
const files=['data/medicines.json','data/nigeria-catalogue.json','data/ingredient-aliases.json','lib/safety.ts','lib/education.ts','lib/scan.ts','app/page.tsx','app/components/Catalogue.tsx','app/components/MedicineCheck.tsx','app/components/AskResistGuard.tsx','app/components/Learning.tsx','app/components/ScanGuide.tsx','app/components/FirstCheckGuide.tsx','app/components/FirstVisitTour.tsx','app/components/Pilot.tsx','lib/scan-guide.ts','public/pilot-protocol.md','data/use-evidence.json','lib/use-check.ts','app/components/UseCheck.tsx','app/api/use-evidence/route.ts'];
const contents=await Promise.all(files.map(async path=>({path,text:(await fs.readFile(path,'utf8')).replace(/\r\n/g,'\n').replace(/^\uFEFF/,'')})));
const digest=createHash('sha256').update(JSON.stringify(contents)).digest('hex');
const nigeria=JSON.parse(contents.find(f=>f.path==='data/nigeria-catalogue.json').text);
const medicines=[...JSON.parse(contents[0].text),...nigeria.records];
const useEvidence=JSON.parse(contents.find(f=>f.path==='data/use-evidence.json').text);
const checklist=[...medicines.map(m=>'record:'+m.id),...Object.keys(nigeria.formulations).map(id=>'formulations:'+id),...nigeria.products.map(p=>'greenbook:'+p.number),'aliases:no-brand-inference','rules:all-scenarios','boundary:no-diagnosis-or-doses','warnings:emergency','education:approved-passages','scan:uncertainty-and-combinations','privacy:consent-wording',...Object.keys(useEvidence.passages).map(id=>'use-evidence:'+id),'use-check:education-and-privacy','amr-lesson:qualitative-education'];
const packet={schema:'resistguard-review-v1',generated:new Date().toISOString(),contentSha256:digest,clinicalReview:'pending',instructions:'A qualified pharmacist must review the exact content, document corrections and complete every checklist item. This packet is not approval. Keep professional identity evidence private.',checklist:checklist.map(id=>({id,decision:'pending',notes:''})),reviewer:{role:'',registrationEvidenceReference:'',reviewedOn:''},files:contents};
await fs.writeFile('public/review-packet.json',JSON.stringify(packet,null,2));
await fs.writeFile('data/content-manifest.json',JSON.stringify({schema:1,contentSha256:digest,reviewStatus:'pending_pharmacist',records:medicines.length},null,2));
console.log('Review packet generated for '+medicines.length+' records. Content SHA256: '+digest);
